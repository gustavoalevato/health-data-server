    {
      "name": "Authentication",
      "item": [
        {
          "name": "Criar access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "description": "Gera um access_token Bearer para acessar os endpoints protegidos. Copie o valor de `access_token` da resposta para a variável `{{accessToken}}` da collection."
          },
          "response": []
        }
      ]
    },
