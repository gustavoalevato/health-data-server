    {
      "name": "Device Audios",
      "item": [
        {
          "name": "Enviar audio gravado para dispositivo",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Arquivo AMR gravado que sera enviado ao dispositivo via comando Touch4P TK."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{imei}}/audios/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "devices",
                "{{imei}}",
                "audios",
                "send"
              ]
            },
            "description": "Recebe um arquivo AMR por multipart/form-data no campo `file` e envia para o relogio Touch4P usando o comando TK. Retorna 200 quando o audio e enfileirado, 400 para arquivo invalido/dispositivo incompatível e 404 quando o dispositivo esta offline."
          },
          "response": []
        },
